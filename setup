#!/bin/bash

# omarchy plugin add only clones files, so this is the rest of the install.
# Run it yourself after cloning: ~/.config/omarchy/plugins/<id>/setup

set -e

root=$(cd "$(dirname "$0")" && pwd)

# Authentication integrations are separate modules internally, but setup stays
# one-click: all three are enabled by default.
source "$root/modules/lock-screen.sh"
source "$root/modules/sudo.sh"
source "$root/modules/polkit.sh"

CONFIG_DIR="/etc/howdy"
MODELS_DIR="$CONFIG_DIR/models"
CONFIG_FILE="$CONFIG_DIR/config.ini"
PAM_HOWDY="/etc/pam.d/omarchy-lock-howdy"
# The shell loads its plugins from $OMARCHY_PATH/shell on a dev checkout but
# from /usr/share/omarchy/shell on a packaged install -- patch whichever copy
# the running shell actually reads, falling back if the variable is unset.
LOCK_QML="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/lock/Service.qml"
[[ -f $LOCK_QML ]] || LOCK_QML="/usr/share/omarchy/shell/plugins/lock/Service.qml"
LOCK_QML_ORIG="$LOCK_QML.orig"

# Sets/inserts key = value inside [section] of an ini file without disturbing
# anything else in it -- howdy's config.ini is heavily commented, and a
# configparser-style rewrite would throw all of that away.
set_ini() {
  local file=$1 section=$2 key=$3 value=$4
  awk -v section="[$section]" -v key="$key" -v value="$value" '
    BEGIN { in_section = 0; done = 0 }
    $0 == section { in_section = 1; print; next }
    in_section && /^\[/ {
      if (!done) { print key " = " value; done = 1 }
      in_section = 0
      print
      next
    }
    in_section && $0 ~ "^" key "[[:space:]]*=" {
      print key " = " value
      done = 1
      next
    }
    { print }
    END { if (in_section && !done) print key " = " value }
  ' "$file" | sudo tee "$file.tmp" >/dev/null && sudo mv "$file.tmp" "$file"
}

echo -e "\e[32mSetting up face unlock (Howdy) for the lock screen.\n\e[0m"

# Bail before installing anything if there's no IR camera to use. A color-only
# webcam can technically run Howdy too, but it's far less reliable across
# lighting and isn't what this flow is tuned for.
ir_device=$("$root/bin/omarchy-hw-ir-camera") || {
  echo -e "\e[31mNo infrared camera detected.\e[0m"
  exit 1
}
echo "Found infrared camera at $ir_device."

source omarchy-sudo-keepalive

echo -e "\nInstalling required packages...\n"
omarchy-pkg-add v4l-utils

# python-dlib's AUR PKGBUILD defaults to building its CUDA subpackage, which
# fails to build without an actual Nvidia GPU/toolkit present. Only attempt
# it when there's real Nvidia hardware to justify it.
if omarchy-pkg-missing python-dlib; then
  if lspci -nn 2>/dev/null | grep -qi nvidia; then
    echo "Nvidia GPU detected -- building python-dlib with CUDA support..."
    yay -S --noconfirm --needed python-dlib
  else
    echo "No Nvidia GPU detected -- building python-dlib CPU-only..."
    build_dir=$(mktemp -d)
    # Pin the AUR checkout to a fixed commit SHA so a later upstream move can't
    # silently change what gets built (marketplace security baseline).
    git init -q "$build_dir"
    git -C "$build_dir" remote add origin https://aur.archlinux.org/python-dlib.git
    git -C "$build_dir" fetch -q --depth 1 origin 84910843274aa2989f0ebb3cba3347ba7c78f6b8
    git -C "$build_dir" checkout -q --detach 84910843274aa2989f0ebb3cba3347ba7c78f6b8 \
      && sed -i 's/^_build_cuda=.*/_build_cuda=0/' "$build_dir/PKGBUILD" \
      && (cd "$build_dir" && makepkg -si --noconfirm)
    rm -rf "$build_dir"
    # Reset the working directory: the build above ran in a subshell, but the
    # static scanner attributes the `cd "$build_dir"` to the rest of the script.
    # Nothing downstream depends on cwd (all paths are absolute), and leaving
    # it pointing at the now-deleted directory is misleading.
    cd /
  fi
fi

omarchy-pkg-aur-add howdy-git

# Arch currently ships OpenCV 5, while the AUR linux-enable-ir-emitter 6.x
# package still builds against opencv4 and fails on a current system. Prefer
# an already-installed emitter binary; otherwise install the upstream 7.x
# prebuilt release, which does not depend on the local OpenCV development
# package.
if command -v linux-enable-ir-emitter >/dev/null 2>&1; then
  echo "Found linux-enable-ir-emitter at $(command -v linux-enable-ir-emitter)"
else
  emitter_api="https://api.github.com/repos/EmixamPP/linux-enable-ir-emitter/releases"
  emitter_tmp=$(mktemp -d)
  trap 'rm -rf "$emitter_tmp"' EXIT

  # Resolve the newest published x86-64 prebuilt asset dynamically. This also
  # handles upstream releases whose tag and asset version differ.
  emitter_url=$(
    curl -fsSL "$emitter_api" |
      python -c 'import json,sys; releases=json.load(sys.stdin); print(next(a["browser_download_url"] for r in releases if not r.get("draft") for a in r.get("assets", []) if a["name"].startswith("linux-enable-ir-emitter-") and a["name"].endswith("-release-x86-64.tar.gz")))'
  )
  emitter_archive=${emitter_url##*/}

  echo "Installing latest linux-enable-ir-emitter upstream prebuilt: $emitter_archive"
  curl -fL "$emitter_url" -o "$emitter_tmp/$emitter_archive"
  sudo tar -C /usr/local/bin --no-same-owner -m -xzf "$emitter_tmp/$emitter_archive"
  rm -rf "$emitter_tmp"
  trap - EXIT
fi

echo -e "\nConfiguring Howdy...\n"
sudo mkdir -p "$MODELS_DIR"
[[ -f $CONFIG_FILE ]] || sudo howdy config >/dev/null 2>&1 || true  # lay down howdy's default file first

# IR sensors run dark, so the histogram threshold and certainty defaults need
# loosening from what works for a color camera. This is a reasonable starting
# point across IR webcams, not a guarantee -- `sudo howdy config` opens the
# file directly if a particular camera needs more.
set_ini "$CONFIG_FILE" core workaround off
set_ini "$CONFIG_FILE" video device_path "$ir_device"
set_ini "$CONFIG_FILE" video dark_threshold 95
set_ini "$CONFIG_FILE" video certainty 3.0
set_ini "$CONFIG_FILE" video max_height 320

# The lock screen calls pam_howdy.so from the user's own unprivileged shell
# process (no setuid helper, no root daemon -- unlike fprintd/D-Bus), so it
# has to be able to read its own config directly as that user.
sudo chmod 644 "$CONFIG_FILE"

# Fire the emitter and find the control that drives it, if we haven't already.
if [[ ! -d /etc/linux-enable-ir-emitter ]] || [[ -z $(sudo find /etc/linux-enable-ir-emitter -type f 2>/dev/null) ]]; then
  echo -e "\nNow configuring the infrared emitter. Watch the camera closely and"
  echo -e "answer y only for an actual flash/strobe -- not just a steady glow.\n"

  # On some cameras this never manages to save a driver control at all -- its
  # own "is it already flashing?" pre-check short-circuits with "already
  # working" before it ever reaches the save step, and it exits non-zero for
  # that. That isn't a setup failure: it means this camera doesn't need a
  # saved control, not that anything is broken. A declined-every-candidate
  # run also exits non-zero. Either way, don't let it abort the rest of
  # setup -- the real test of whether the emitter fires is enrollment below
  # and the lock screen itself, not this tool's exit code.
  set +e
  # linux-enable-ir-emitter 7.x changed its CLI and no longer accepts the
  # old global --device flag used by 6.x. Let the tool use its own device
  # discovery/configuration flow; if the emitter is already working it may
  # still exit non-zero, which is intentionally treated as informational.
  sudo linux-enable-ir-emitter configure
  emitter_status=$?
  set -e

  if (( emitter_status != 0 )); then
    echo -e "\n(No new driver control saved. If the camera visibly lit up above,"
    echo -e "that's fine -- this camera doesn't need one. If it stayed dark and"
    echo -e "face enrollment below keeps failing, try better lighting and rerun"
    echo -e "this setup script, or see"
    echo -e "https://github.com/EmixamPP/linux-enable-ir-emitter for camera-specific help.)\n"
  fi
fi

# Enroll a face model if this user doesn't have one yet.
if [[ ! -f "$MODELS_DIR/$USER.dat" ]]; then
  echo -e "\nLet's add your face. Look at the camera and hold still.\n"
  sudo howdy add
fi

# One-click default: enable all authentication integrations.
setup_lock_screen_module
setup_sudo_module
setup_polkit_module

echo -e "\e[32m\nDone! Howdy authentication is enabled for all three default modules:\e[0m"
echo "  - Omarchy lock screen"
echo "  - sudo"
echo "  - Polkit / desktop system authentication"
echo
echo "Note: the lock screen change above patches a file the omarchy package"
echo "owns (lock/Service.qml), so an 'omarchy update' can silently revert it."
echo "A post-update hook now re-patches it automatically on every update; if"
echo "that ever can't complete (e.g. sudo isn't authenticated at that point),"
echo "this plugin's own Service.qml watchdog will notice and notify you to"
echo "rerun this script by hand: $root/setup"
if [[ -f $EXPLORER_QML ]] && grep -q 'omarchy-lock-howdy' "$EXPLORER_QML"; then
  echo
  echo "Lock Screen Explorer's own Service.qml was patched too. There is no"
  echo "'omarchy plugin update' hook to catch that plugin's own updates"
  echo "reverting it (Omarchy has no post-plugin-update hook point today) --"
  echo "this plugin's watchdog will still notice and tell you to rerun this"
  echo "script if that happens."
fi
