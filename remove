#!/bin/bash

# Undoes what ./setup did. Run it yourself: ~/.config/omarchy/plugins/<id>/remove

set -e

root=$(cd "$(dirname "$0")" && pwd)
source "$root/modules/lock-screen.sh"
source "$root/modules/sudo.sh"
source "$root/modules/polkit.sh"

PAM_HOWDY="/etc/pam.d/omarchy-lock-howdy"
# Match setup's path resolution: patch/restore whichever copy the running
# shell actually reads (dev checkout vs. packaged install).
LOCK_QML="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/lock/Service.qml"
[[ -f $LOCK_QML ]] || LOCK_QML="/usr/share/omarchy/shell/plugins/lock/Service.qml"
LOCK_QML_ORIG="$LOCK_QML.orig"
EXPLORER_QML="$HOME/.config/omarchy/plugins/io.github.sirjul1337.lock-explorer/Service.qml"
EXPLORER_QML_ORIG="$EXPLORER_QML.orig"
POST_UPDATE_HOOK="$HOME/.config/omarchy/hooks/post-update.d/repair-howdy-lock.hook"

echo -e "\e[32mRemoving face unlock (Howdy) from the lock screen.\n\e[0m"

# Remove only configuration this plugin owns; each integration is independent.
remove_lock_screen_module
remove_sudo_module
remove_polkit_module

echo "Removing Howdy packages..."
omarchy-pkg-drop howdy-git linux-enable-ir-emitter python-dlib

echo -e "\e[32m\nFace unlock has been completely removed.\e[0m"
echo "(Your enrolled face model at /etc/howdy/models and /etc/howdy/config.ini"
echo "were left in place in case you reinstall Howdy later.)"
echo
echo "You'll probably also want to remove the plugin itself:"
echo "  omarchy plugin remove io.github.feixionglee.howdy-face-unlock"
