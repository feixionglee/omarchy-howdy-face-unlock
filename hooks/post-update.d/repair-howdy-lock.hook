#!/bin/bash
# Installed by this plugin's setup via `omarchy hook install post-update`.
# Runs during `omarchy update`, right after system packages and migrations --
# i.e. right after the package-owned lock/Service.qml this plugin patches may
# have just been overwritten back to stock. Re-patch it here, silently, so
# face unlock survives an update instead of needing a manual `setup` rerun
# every time. Falls back to the old notify-and-wait behavior (this plugin's
# own Service.qml watchdog) if the repair can't complete.

set -u

PLUGIN_DIR="$HOME/.config/omarchy/plugins/io.github.feixionglee.howdy-face-unlock"
[[ -f $PLUGIN_DIR/manifest.json ]] || exit 0  # plugin removed; nothing to repair

# ------------------------------------------------------------ stock lock --

# The shell loads its plugins from $OMARCHY_PATH/shell on a dev checkout but
# from /usr/share/omarchy/shell on a packaged install -- match setup's own
# resolution so this repairs whichever copy the running shell actually reads.
LOCK_QML="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/lock/Service.qml"
[[ -f $LOCK_QML ]] || LOCK_QML="/usr/share/omarchy/shell/plugins/lock/Service.qml"

PATCHER="$PLUGIN_DIR/patch-lock-howdy.py"

if [[ -f $LOCK_QML ]] && ! grep -q 'omarchy-lock-howdy' "$LOCK_QML"; then
  echo "Howdy Face Unlock: re-patching lock screen after update..."

  # omarchy-update already ran the pacman step under sudo in this same
  # terminal, so sudo should still be authenticated here without a fresh
  # prompt. If it isn't (e.g. this hook ran long after that, or credentials
  # were reset), fail quietly -- the watchdog in this plugin's own
  # Service.qml will still notice and tell the user to rerun setup by hand.
  if ! sudo -n true 2>/dev/null; then
    echo "Howdy Face Unlock: sudo not available non-interactively; skipping repair (will notify instead)."
  else
    # Patch a user-owned temporary copy; sudo is used only to install the
    # resulting data file. No plugin-provided Python is ever executed as root.
    scratch_dir=$(mktemp -d) || exit 0
    cp "$LOCK_QML" "$scratch_dir/Service.qml" || { rm -rf "$scratch_dir"; exit 0; }
    if python3 "$PATCHER" "$scratch_dir/Service.qml"; then
      sudo -n install -o root -g root -m 644 "$scratch_dir/Service.qml" "$LOCK_QML"
      patch_status=$?
    else
      patch_status=$?
    fi
    rm -rf "$scratch_dir"

    if (( patch_status != 0 )); then
      echo "Howdy Face Unlock: automatic repair failed; rerun $PLUGIN_DIR/setup" >&2
    else
      echo "Howdy Face Unlock: lock screen re-patched."
    fi
  fi
fi

# ------------------------------------------------------- lock explorer ---

# Lock Screen Explorer (io.github.sirjul1337.lock-explorer) keeps its own
# Service.qml in the user's plugin checkout, independent of the stock file
# above -- see patch-lock-howdy-explorer.py and setup for the full design
# rationale. `omarchy update` doesn't touch that checkout (it's pulled by
# `omarchy plugin update`, a separate command with no hook point of its
# own today), so this mainly re-catches drift from something else having
# reset it -- a manual git reset, a corrupted checkout, etc. It's a cheap
# extra safety net on every `omarchy update` run, not the primary repair
# path for that plugin's own updates; this plugin's Service.qml watchdog
# is what catches those (see setup's closing note).
EXPLORER_QML="$HOME/.config/omarchy/plugins/io.github.sirjul1337.lock-explorer/Service.qml"
if [[ -f $EXPLORER_QML ]] && ! grep -q 'omarchy-lock-howdy' "$EXPLORER_QML"; then
  echo "Howdy Face Unlock: re-patching Lock Screen Explorer after update..."
  # No root, no hash-check dance: this file is already owned by the
  # invoking user (same as the rest of their plugin checkouts), so running
  # the patcher against it doesn't cross a privilege boundary the way the
  # stock, package-owned file above does -- see setup's comment on this
  # same point for the full reasoning.
  if python3 "$PLUGIN_DIR/patch-lock-howdy-explorer.py" "$EXPLORER_QML"; then
    echo "Howdy Face Unlock: Lock Screen Explorer's lock screen re-patched."
  else
    echo "Howdy Face Unlock: Explorer repair failed (its structure may have changed" >&2
    echo "upstream); rerun $PLUGIN_DIR/setup or see this plugin's README." >&2
  fi
fi

exit 0
